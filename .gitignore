# Environment and caches
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Generated workbooks and test output (rebuilt by scripts\run.ps1)
out/

# The logs of the scripts (one file per script, last run only): the folder is kept, not its content
scripts/logs/*
!scripts/logs/.gitkeep

# Excel binaries, wherever they are (the VBA and the Python that build them are the source)
*.xlsm
*.xlsx
*.xlsb
*.xls
~$*

# Local tools and editors (.claude/ is versioned, except the personal settings)
.claude/settings.local.json
.vscode/
.idea/
Thumbs.db
